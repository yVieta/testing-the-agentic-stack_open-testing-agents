import AgentHarness
open AgentHarness

-- Tuning check CLI: `lake env lean --run Main.lean q d c s k`
-- prints accepted|rejected
def parse (s : String) : Nat :=
  match s.toNat? with
  | some n => n
  | none => 0

def main (args : List String) : IO Unit :=
  match args with
  | [q, d, c, s, k] =>
    let t : Tuning :=
      { queue_size := parse q, dedupe_cap := parse d,
        crew_timeout := parse c, steps := parse s, step_cost := parse k }
    match review t with
    | Verdict.accepted => IO.println "accepted"
    | Verdict.rejected => IO.println "rejected"
  | _ => IO.println "usage: Main.lean queue_size dedupe_cap crew_timeout steps step_cost"
