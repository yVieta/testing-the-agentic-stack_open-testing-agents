1: -- Schema for the aigents vector store.
2: --
3: -- Runs once, from the pgvector image's /docker-entrypoint-initdb.d hook, when the
4: -- data directory is still empty. ${embedding_dimensions} matches the hidden size
5: -- of the Phi-4 embedding space, so vectors produced by the model container drop
6: -- straight into these tables.
7: 
8: CREATE EXTENSION IF NOT EXISTS vector;
9: 
10: -- ---------------------------------------------------------------- documents
11: -- One row per embedded document. content is the raw text handed to the model,
12: -- metadata carries whatever the caller wants to filter on.
13: CREATE TABLE IF NOT EXISTS documents (
14:   id          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
15:   collection  TEXT        NOT NULL DEFAULT 'default',
16:   source      TEXT,
17:   content     TEXT        NOT NULL,
18:   metadata    JSONB       NOT NULL DEFAULT '{}'::jsonb,
19:   created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
20: );
21: 
22: CREATE INDEX IF NOT EXISTS documents_collection_idx ON documents (collection);
23: 
24: -- ---------------------------------------------------------------- embeddings
25: -- Vectors live in their own table so an ANN index can be rebuilt without
26: -- touching the document rows.
27: CREATE TABLE IF NOT EXISTS document_embeddings (
28:   document_id BIGINT PRIMARY KEY REFERENCES documents (id) ON DELETE CASCADE,
29:   model       TEXT        NOT NULL,
30:   dimensions  INTEGER     NOT NULL,
31:   embedding   vector(${embedding_dimensions}) NOT NULL,
32:   created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
33: );
34: 
35: CREATE INDEX IF NOT EXISTS document_embeddings_model_idx
36:   ON document_embeddings (model);
37: 
38: -- ------------------------------------------------------------------ search
39: -- Cosine distance lookup. This is an exact scan; pgvector handles the ORDER BY
40: -- just fine until the table grows, at which point add an ANN index (IVFFlat
41: -- needs rows to exist first, HNSW does not, hence why neither is created here):
42: --
43: --   CREATE INDEX document_embeddings_ivfflat
44: --     ON document_embeddings USING ivfflat (embedding vector_cosine_ops)
45: --     WITH (lists = 200);
46: --
47: --   CREATE INDEX document_embeddings_hnsw
48: --     ON document_embeddings USING hnsw (embedding vector_cosine_ops);
49: CREATE OR REPLACE FUNCTION match_documents(
50:   query_embedding     vector(${embedding_dimensions}),
51:   match_count         INTEGER DEFAULT 8,
52:   filter_collection   TEXT    DEFAULT NULL,
53:   filter_metadata     JSONB   DEFAULT NULL
54: )
55: RETURNS TABLE (
56:   document_id BIGINT,
57:   content     TEXT,
58:   metadata    JSONB,
59:   distance    DOUBLE PRECISION
60: )
61: LANGUAGE sql
62: STABLE
63: AS $$
64:   SELECT
65:     e.document_id,
66:     d.content,
67:     d.metadata,
68:     e.embedding <=> query_embedding AS distance
69:   FROM document_embeddings e
70:   JOIN documents d ON d.id = e.document_id
71:   WHERE (filter_collection IS NULL OR d.collection = filter_collection)
72:     AND (filter_metadata IS NULL OR d.metadata @> filter_metadata)
73:   ORDER BY e.embedding <=> query_embedding
74:   LIMIT match_count;
75: $$;

