theorem greedy_rejected : Not (WellTuned greedy)
  | ⟨_, bo⟩ =>
    match Nat.compare (greedy.steps * greedy.step_cost) greedy.crew_timeout with
    | Dec.yes p => p bo
    | Dec.no np => np bo

def proposal : Tuning :=
