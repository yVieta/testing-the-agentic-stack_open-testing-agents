    subgraph PIS["Microservices via OCI container"]
        direction LR
        PI1["<b> </b><br/>e2e engineer"]
        PI2["<b> </b><br/>pentester"]
        PI3["<b> </b><br/>test manager"]
    end

    subgraph SERVERS["Self-Hosted Hardware Server (8GB GPU / 16GB RAM)"]
        direction TB
        BROKER["<b> </b><br/>EMQX Central Hub"]
        AGDA["<b>Lean4 Proof Assistant</b><br/>Formal Agent Harnessing & Tuning"]
        GPU["<b>Model & Database Server</b><br/>Phi-4 (Q4_K_M)"]
    end

    SUT <-->|"http"| PI1
    SUT <-->|"http"| PI2
    SUT <-->|"http"| PI3

    BROKER <-->|"MQTT 1883 / 8883"| PI1
    BROKER <--> PI2
    BROKER <--> PI3
    BROKER <--> GPU
    BROKER <--> AGDA

    classDef sut fill:#e8f0fe,stroke:#4285f4,color:#202124;
    classDef pi fill:#e6f4ea,stroke:#34a853,color:#202124;
    classDef server fill:#fef7e0,stroke:#fbbc04,color:#202124;
    class SUT sut;
