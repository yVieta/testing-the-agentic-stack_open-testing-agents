import AgentHarness
open AgentHarness

-- Validate a tuning proposal over stdin/args; prints accepted|rejected.
def parseNat (s : String) : Nat :=
  match s.toNat? with | some n => n | none => 0

def main (args : List String) : IO Unit :=
  match args with
  | [q, d, c, s, k] =>
    let t : Tuning := { queue_size := parseNat q, dedupe_cap := parseNat d,
                        crew_timeout := parseNat c, steps := parseNat s, step_cost := parseNat k }
    match review t with
    | Verdict.accepted => IO.println "accepted"
    | Verdict.rejected => IO.println "rejected"
  | _ => IO.println "usage: <q> <d> <c> <s> <k>"
