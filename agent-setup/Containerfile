# Agent runtime: crewAI + the Lean4 harness (elan-installed toolchain) +
# postgres client. Built by agent-setup with the repo root as build context.
FROM docker.io/library/python:3.12-slim

# build essentials + toolchain downloader
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

# lean4 via elan (toolchain pinned by skills/lean/lean-toolchain)
ENV ELAN_HOME=/root/.elan
ENV PATH="${ELAN_HOME}/bin:${PATH}"
RUN curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -sSf \
    | sh -s -- -y --default-toolchain leanprover/lean4:v4.23.0

# crewai + postgres client.
# litellm is required: the crew JSONs point at the local model via the
# LiteLLM "openai/<model>" route (OPENAI_API_BASE), and crewai >= 1.15
# moved litellm into an extra.
RUN pip install --no-cache-dir \
      "crewai[tools,litellm]>=1.15.20,<2.0.0" \
      "psycopg[binary]>=3.2"

# Playwright + a system-wide Chromium so the e2e agent drives a real browser.
# PLAYWRIGHT_BROWSERS_PATH keeps the browser out of the venv crewai builds with
# --system-site-packages, so it stays visible at runtime; `playwright install
# --with-deps` also pulls the shared libraries Chromium needs.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN pip install --no-cache-dir "playwright>=1.47,<2.0.0" \
 && playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.cache/pip

# bake the formal harness into the image (repo stays read-only at runtime)
COPY skills/lean /opt/harness/
RUN cd /opt/harness && lake build

# agents read crew defs + the runner from /repo; kept read-only.
WORKDIR /repo