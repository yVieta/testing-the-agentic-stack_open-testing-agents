# Agent runtime BASE image: crewAI + the Lean4 harness (elan-installed
# toolchain) + postgres client + curl/git. Built by agent-setup with the repo
# root as build context, tagged `localhost/aigents-agent-base`.
#
# Role-specific tools (Playwright for e2e, the scanners for the pentester, ...)
# are NOT baked in here: they are declared in agent-setup/tools.tf and layered
# on top of this base by the generated per-role image (containerfile-role.tftpl
# -> .build/<role>/Containerfile). See tools.tf for the catalog.
FROM docker.io/library/python:3.12-slim

# build essentials + toolchain downloader. curl/git are also used by the role
# layers (binary downloads, git-based tools like nikto).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

# lean4 via elan (toolchain pinned by skills/lean/lean-toolchain)
ENV ELAN_HOME=/root/.elan
ENV PATH="${ELAN_HOME}/bin:${PATH}"
RUN curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -sSf \
    | sh -s -- -y --default-toolchain leanprover/lean4:v4.23.0

# crewai + postgres client.
# litellm is required: the crew JSONs point at the local model via the
# LiteLLM "openai/<model>" route (OPENAI_API_BASE), and crewai >= 1.15
# moved litellm into an extra.
RUN pip install --no-cache-dir \
      "crewai[tools,litellm]>=1.15.20,<2.0.0" \
      "psycopg[binary]>=3.2"

# bake the formal harness into the image (repo stays read-only at runtime)
COPY skills/lean /opt/harness/
RUN cd /opt/harness && lake build

# agents read crew defs + the runner from /repo; kept read-only.
WORKDIR /repo
