[Unit]
Description=aigents testing agent ${agent_role} (crew ${role_dir})
After=network-online.target
Wants=network-online.target

[Container]
Image=${image}
Pull=never
Network=host
Volume=${repo_dir}:/repo:ro,Z
Volume=${credential_file}:/run/secrets/credentials.env:ro,Z
Volume=${odysseus_secrets_dir}:/run/secrets/odysseus:ro,Z
Environment=CREW_ROLE=${agent_role}
Environment=CREW_DIR=/repo/build/${role_dir}
Environment=MODEL_URL=${model_url}
Environment=MODEL_NAME=${model_name}
Environment=MODEL_FAST_URL=${model_fast_url}
Environment=MODEL_FAST_NAME=${model_fast_name}
Environment=TARGET_URL=${target_url}
Environment=MCP_URL=${mcp_url}
Environment=RUN_INTERVAL=${run_interval}
Exec=python3 /repo/worker/run_agent.py

[Service]
Restart=always
RestartSec=15
# Self-healing bind sources: podman refuses to start when a bind mount source
# is missing. Recreate the odysseus secrets dir and the credentials file on
# every start, so a wiped path (or a manual cleanup) cannot wedge the agent.
ExecStartPre=/bin/sh -c 'mkdir -p "$(dirname "${credential_file}")" "${odysseus_secrets_dir}" && chmod 0700 "${odysseus_secrets_dir}" && [ -e "${credential_file}" ] || : > "${credential_file}"'

[Install]
WantedBy=default.target