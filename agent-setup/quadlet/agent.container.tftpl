[Unit]
Description=aigents testing agent ${agent_role} (crew ${role_dir})
# No After/Wants=network-online.target: the podman user generator turns that
# into a hard dependency on podman-user-wait-network-online.service, which
# hangs in this environment (user-level network-online.target never completes)
# and makes every `systemctl start/restart` of the agent block until timeout.
# The stack is all localhost (model, bus, SUT), so no online wait is needed.

[Container]
Image=${image}
Pull=never
Network=host
Volume=${repo_dir}:/repo:ro,Z
Volume=${credential_file}:/run/secrets/credentials.env:ro,Z
Volume=${results_dir}/${role_dir}:/results:rw,Z
Environment=CREW_ROLE=${agent_role}
Environment=CREW_DIR=/repo/build/${role_dir}
Environment=MODEL_URL=${model_url}
Environment=MODEL_NAME=${model_name}
Environment=MODEL_FAST_URL=${model_fast_url}
Environment=MODEL_FAST_NAME=${model_fast_name}
Environment=TARGET_URL=${target_url}
Environment=MCP_URL=${mcp_url}
Environment=RUN_INTERVAL=${run_interval}
Environment=RESULTS_DIR=/results
Exec=python3 /repo/worker/run_agent.py

[Service]
# Give the crew enough time to complete and save results (crew can take 2+ hours)
TimeoutStopSec=14400

[Install]
WantedBy=default.target