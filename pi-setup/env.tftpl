# Generated by pi-setup/terraform - dhallcrew worker "${role}"
# MQTT + target settings for one Raspberry Pi (Raspberry Pi OS).
CREW_ROLE=${agent_role}
MQTT_TOPIC_PREFIX=${topic_prefix}
BROKER_HOST=${broker_host}
BROKER_PORT=${broker_port}
BROKER_USERNAME=${broker_username}
BROKER_PASSWORD=${broker_password}
TARGET_URL=${target_url}
%{ if tls_ca != "" }BROKER_TLS_CA=${tls_ca}
BROKER_TLS_REQUIRE_CERT=${tls_require_cert}
%{ endif }