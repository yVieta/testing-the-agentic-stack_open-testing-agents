# Per-PI worker environment template.
#
# On NixOS the non-secret settings (BROKER_HOST, BROKER_PORT, BROKER_TLS_CA,
# TARGET_URL, MQTT_TOPIC_PREFIX) are set declaratively by the module
# nix/modules/crew-worker.nix. This file is only for the SECRETS that must
# not live in the nix store; it lives at /etc/dhallcrew/<role>.env on each
# host (created manually - fill in BROKER_PASSWORD, then copy per role).
#
# For quick manual testing (non-NixOS), you can also copy this whole file to
# build/<role>/.env and fill in every value.

# --- MQTT credentials (required on every host) -------------------------------
BROKER_USERNAME=pi1-e2e
BROKER_PASSWORD=change-me

# --- Local server under test ------------------------------------------------
# TARGET_URL is set by the module on NixOS; uncomment for manual runs.
# TARGET_URL=http://10.0.0.20

# --- Broker settings (optional; module defaults apply on NixOS) ---------------
# BROKER_HOST=10.0.0.10
# BROKER_PORT=8883
# BROKER_TLS_CA=/etc/dhallcrew/certs/ca.crt
# BROKER_TLS_REQUIRE_CERT=true
# MQTT_TOPIC_PREFIX=crew