[Unit]
Description=Qdrant vector store (aigents)
After=${pod_unit}
Requires=${pod_unit}

[Container]
Image=${qdrant_image}
Pull=${image_pull_policy}
Pod=${pod_file}
Volume=${qdrant_data_dir}:/qdrant/storage:Z
Environment=QDRANT__SERVICE__API_KEY=${qdrant_api_key}
Environment=QDRANT__SERVICE__ENABLE_CORS=true
Environment=QDRANT__STORAGE__PERFORMANCE__MAX_SEARCH_THREADS=${qdrant_max_search_threads}
HealthCmd=/bin/bash -c "exec 3<>/dev/tcp/127.0.0.1/6333 && printf 'GET /readyz HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 && grep -qm1 '200 OK' <&3"
HealthInterval=15s
HealthStartPeriod=20s
HealthRetries=10

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=${pod_unit}
