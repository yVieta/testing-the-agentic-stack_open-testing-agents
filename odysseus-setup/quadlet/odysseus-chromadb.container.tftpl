[Unit]
Description=odysseus ChromaDB vector store (systemd-managed container)
# No network-online.target (see odysseus-app.container.tftpl)

[Container]
Image=${chromadb_image}
ContainerName=odysseus-chromadb
PublishPort=${bind_address}:${chromadb_port}:8000
Volume=odysseus-chromadb-data:/chroma/chroma
Environment=ANONYMIZED_TELEMETRY=FALSE

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target