[Unit]
Description=odysseus ntfy notification push (systemd-managed container)
# No network-online.target (see odysseus-app.container.tftpl)

[Container]
Image=${ntfy_image}
ContainerName=odysseus-ntfy
Exec=serve
PublishPort=${bind_address}:${ntfy_port}:80
Volume=odysseus-ntfy-cache:/var/cache/ntfy
Environment=NTFY_BASE_URL=http://localhost:${ntfy_port}

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target